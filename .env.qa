NEW_EXPENSIFY_URL=https://qa.new.exops.io/
EXPENSIFY_URL=https://qa.exops.io/
SECURE_EXPENSIFY_URL=https://qa-secure.exops.io/
QA_EXPENSIFY_URL=https://qa.exops.io/
QA_SECURE_EXPENSIFY_URL=https://qa-secure.exops.io/
# Injected by the QA deploy job from a like-named CI secret; dotenv takes the last occurrence, so that
# append wins over this line. Declared empty so a local ENV=qa build has no key, not the production one.
PUSHER_QA_APP_KEY=
ENVIRONMENT=qa
USE_WEB_PROXY=false
SEND_CRASH_REPORTS=true
